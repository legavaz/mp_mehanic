// Серверная логика приложения «ИСТК Механики».

// Возвращает текущий статус заказ-наряда по ссылке (или Неопределено).
Функция СтатусЗаказНаряда(Ссылка) Экспорт
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	мхЗаказНаряд.мхСтатус КАК мхСтатус
	|ИЗ
	|	Документ.мхЗаказНаряд КАК мхЗаказНаряд
	|ГДЕ
	|	мхЗаказНаряд.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.мхСтатус;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Заполняет табличную часть «Работы» регламентными работами.
Процедура ЗаполнитьРегламентныеРаботы(Документ) Экспорт
	Документ.мхРаботы.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	мхРегламентныеРаботы.Ссылка КАК Работа,
	|	мхРегламентныеРаботы.Наименование КАК Наименование,
	|	мхРегламентныеРаботы.мхНормочасы КАК Нормочасы
	|ИЗ
	|	Справочник.мхРегламентныеРаботы КАК мхРегламентныеРаботы
	|ГДЕ
	|	НЕ мхРегламентныеРаботы.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Документ.мхРаботы.Добавить();
		НоваяСтрока.мхРабота = Выборка.Работа;
		НоваяСтрока.мхНаименование = Выборка.Наименование;
		НоваяСтрока.мхНормочасы = Выборка.Нормочасы;
	КонецЦикла;
КонецПроцедуры

// Заполняет чек-лист пунктами шаблона, подобранного по бренду техники.
Процедура ЗаполнитьЧекЛистПоШаблону(Документ) Экспорт
	Документ.мхПунктыЧекЛиста.Очистить();
	Если НЕ ЗначениеЗаполнено(Документ.мхТехника) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧПункты.мхНаименование КАК Пункт,
	|	ТЧПункты.мхБлок КАК Блок,
	|	ТЧПункты.мхПорядок КАК Порядок
	|ИЗ
	|	Справочник.мхШаблоныЧекЛистов.мхПунктыПроверки КАК ТЧПункты
	|ГДЕ
	|	ТЧПункты.Ссылка.мхВидТехники = &ВидТехники
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	Запрос.УстановитьПараметр("ВидТехники", Документ.мхТехника.мхБренд);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Документ.мхПунктыЧекЛиста.Добавить();
		НоваяСтрока.мхПункт = Выборка.Пункт;
		НоваяСтрока.мхБлок = Выборка.Блок;
		НоваяСтрока.мхРезультат = Перечисления.мхРезультатыПроверки.Исправно;
	КонецЦикла;
КонецПроцедуры

// Заполняет обязательный состав фотографий осмотра.
Процедура ЗаполнитьСоставФотоОсмотра(Документ) Экспорт
	Документ.мхФотоОсмотра.Очистить();
	ТипыФото = Новый Массив;
	ТипыФото.Добавить("Общий вид 1");
	ТипыФото.Добавить("Общий вид 2");
	ТипыФото.Добавить("Общий вид 3");
	ТипыФото.Добавить("Общий вид 4");
	ТипыФото.Добавить("Экран");
	ТипыФото.Добавить("Шильдик");
	ТипыФото.Добавить("Рабочие органы");
	ТипыФото.Добавить("Старые фильтры");
	Для Каждого ТипФото Из ТипыФото Цикл
		НоваяСтрока = Документ.мхФотоОсмотра.Добавить();
		НоваяСтрока.мхТипФото = ТипФото;
	КонецЦикла;
КонецПроцедуры

// Проверяет готовность заказ-наряда к закрытию. Возвращает Истина, если закрыть можно.
Функция ПроверитьГотовностьКЗакрытию(Документ, ТекстОшибки) Экспорт
	ТекстОшибки = "";
	Если Документ.мхСтатус <> Перечисления.мхСтатусыЗН.Закрыт Тогда
		Возврат Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ.мхНаработкаВизитаМоточасы)
		И НЕ ЗначениеЗаполнено(Документ.мхНаработкаВизитаПробег) Тогда
		ТекстОшибки = "Перед закрытием ЗН необходимо внести фактическую наработку (моточасы или пробег).";
		Возврат Ложь;
	КонецЕсли;
	Если НЕ Документ.мхПодписьПолучена Тогда
		ТекстОшибки = "Перед закрытием ЗН необходимо получить подпись клиента.";
		Возврат Ложь;
	КонецЕсли;
	Для Каждого СтрокаТовар Из Документ.мхТовары Цикл
		Если НЕ СтрокаТовар.мхПолученоНаСкладе Тогда
			ТекстОшибки = "Не все запасные части приняты на складе.";
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаРабота Из Документ.мхРаботы Цикл
		Если НЕ СтрокаРабота.мхВыполнено Тогда
			ТекстОшибки = "Не все работы отмечены как выполненные.";
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Записывает текущий статус заказ-наряда в регистр истории.
Процедура ЗаписатьИсториюСтатуса(Документ) Экспорт
	НаборЗаписей = РегистрыСведений.мхИсторияСтатусовЗН.СоздатьНаборЗаписей();
	Запись = НаборЗаписей.Добавить();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.мхЗаказНаряд = Документ.Ссылка;
	Запись.мхСтатус = Документ.мхСтатус;
	НаборЗаписей.Записать();
КонецПроцедуры

// Считает сумму нормочасов по отмеченным выполненным работам.
Функция НормочасыПоЗаказНаряду(Документ) Экспорт
	СуммаНормочасов = 0;
	Для Каждого СтрокаРабота Из Документ.мхРаботы Цикл
		Если СтрокаРабота.мхВыполнено Тогда
			СуммаНормочасов = СуммаНормочасов + СтрокаРабота.мхНормочасы;
		КонецЕсли;
	КонецЦикла;
	Возврат СуммаНормочасов;
КонецФункции
