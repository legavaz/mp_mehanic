Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если НЕ ЗначениеЗаполнено(мхТехника) Тогда
		Сообщить("Не указана техника.");
		Отказ = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(мхЗаказчик) Тогда
		Сообщить("Не указан заказчик.");
		Отказ = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(мхВидРабот) Тогда
		Сообщить("Не указан вид работ.");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	ТекстОшибки = "";
	Если НЕ мхМеханикиСервер.ПроверитьГотовностьКЗакрытию(ЭтотОбъект, ТекстОшибки) Тогда
		Сообщить(ТекстОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ПредыдущийСтатус = мхМеханикиСервер.СтатусЗаказНаряда(Ссылка);
	Если ПредыдущийСтатус <> мхСтатус Тогда
		ДополнительныеСвойства.Вставить("мхСтатусИзменен", Истина);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ДополнительныеСвойства.Свойство("мхСтатусИзменен") Тогда
		мхМеханикиСервер.ЗаписатьИсториюСтатуса(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.мхНаработкаТехники.Записывать = Истина;
	Движения.мхНаработкаТехники.Очистить();
	Если мхСтатус <> Перечисления.мхСтатусыЗН.Закрыт Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(мхТехника) Тогда
		Возврат;
	КонецЕсли;
	Движение = Движения.мхНаработкаТехники.Добавить();
	Движение.Период = Дата;
	Движение.мхТехника = мхТехника;
	Движение.мхМоточасы = мхНаработкаВизитаМоточасы;
	Движение.мхПробег = мхНаработкаВизитаПробег;
КонецПроцедуры
