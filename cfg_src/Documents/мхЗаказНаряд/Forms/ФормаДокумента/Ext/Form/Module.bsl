	ЗаполнитьЧекЛистНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЧекЛистНаСервере()
	мхМеханикиСервер.ЗаполнитьЧекЛистПоШаблону(Объект);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФото(Команда)
	ЗаполнитьФотоНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФотоНаСервере()
	мхМеханикиСервер.ЗаполнитьСоставФотоОсмотра(Объект);
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьЗН(Команда)
	ЗакрытьЗННаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗакрытьЗННаСервере()
	ТекстОшибки = "";
	Объект.мхСтатус = Перечисления.мхСтатусыЗН.Закрыт;
	Если НЕ мхМеханикиСервер.ПроверитьГотовностьКЗакрытию(Объект, ТекстОшибки) Тогда
		Сообщить(ТекстОшибки);
		Возврат;
	КонецЕсли;
	Записать();
КонецПроцедуры
