// HTTP-сервис интеграции с мобильным приложением «ИСТК Механики». Заготовка.

Функция ЗаказыGet(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	// ЗАГОТОВКА: получить список заявок механика.
	мхМеханикиОбмен.ПолучитьЗаявкиМеханика("", НачалоГода(ТекущаяДатаСеанса()), ТекущаяДатаСеанса());
	Ответ.УстановитьТелоИзСтроки("{""orders"": []}", КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ЗаказыPost(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	// ЗАГОТОВКА: принять результаты заказ-наряда из мобильного приложения.
	Ответ.УстановитьТелоИзСтроки("{""status"": ""ok""}", КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ЗдоровьеGet(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки("ok", КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции
